<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current"
    xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <PropertyGroup>
        <!-- TargetFramework is set per project. -->
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <NeutralLanguage>en</NeutralLanguage>
        <NoWarn>1701;1702</NoWarn>
        <Nullable>enable</Nullable>

        <!-- NuGet package metadata. NOTE: Some properties are set in each packable project. -->
        <Title>Provision Data Application Framework</Title>
        <Description>Framework and tools for implementing applications following best practices in developer friendly ways.</Description>
        <Authors>ProvisionData</Authors>
        <Company>Provision Data Systems Inc.</Company>
        <License>MIT</License>
        <Copyright>2026 Provision Data Systems Inc.</Copyright>
        <RepositoryUrl>https://github.com/provisiondata/ProvisionData.Common.git</RepositoryUrl>
        <PackageProjectUrl>https://github.com/provisiondata/ProvisionData.Common</PackageProjectUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
        <ApplicationIcon>..\..\pdsi.ico</ApplicationIcon>
        <PackageIcon>pdsi.png</PackageIcon>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <RepositoryBranch>main</RepositoryBranch>
        <RepositoryCommit>$(SourceRevisionId)</RepositoryCommit>

        <!--
		This controls NuGet package vulnerability scanning during restore.
		Direct means:
		- Only top‑level packages are scanned for vulnerabilities.
		- Transitive dependencies are not audited.
		-->
        <NuGetAuditMode>direct</NuGetAuditMode>

        <!--
		Turns .editorconfig code‑style rules into build errors. Meaning that if a contributor violates
		a code‑style rule, the build will fail until they fix it.
    
        e.g.  dotnet_style_qualification_for_field = true:error
        And someone violates it the build fails. It does not enforce formatting (indentation, spacing).
		Only code‑style analyzers are enforced.
		-->
        <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>

        <!-- Enable SourceLink -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>

        <!-- Generate snupkg symbol packages -->
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>

        <!-- Ensure portable PDBs -->
        <DebugType>portable</DebugType>
        <DebugSymbols>true</DebugSymbols>

        <!-- Deterministic builds for reproducibility -->
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>

        <!--
		Assembly attributes are generated by NerdBank.GitVersioning/version.json files.
		This disables SDK automatic generation to avoid conflicting assembly attributes. -->
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GitVersionBaseDirectory>$(MSBuildThisFileDirectory)</GitVersionBaseDirectory>
        <!-- This is a default. Individual projects should override these values with the package namespace. -->
        <NBGV_ThisAssemblyNamespace>ProvisionData</NBGV_ThisAssemblyNamespace>
        <NBGV_ThisAssemblyIncludesPackageVersion>true</NBGV_ThisAssemblyIncludesPackageVersion>
    </PropertyGroup>

    <!--
	Ensure LICENSE and Icon are packed. Projects are responsible for their own README files.
	-->
    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)LICENSE.md" Pack="true" PackagePath="/" />
        <None Include="$(MSBuildThisFileDirectory)pdsi.png" Pack="true" PackagePath="/"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Nerdbank.GitVersioning">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.SourceLink.GitHub">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>