<?xml version="1.0" encoding="utf-8"?>
<configuration>

    <packageSources>

        <!--To inherit the global NuGet package sources remove the <clear/> line below -->
        <clear />
        <add key="LocalPackages" value="D:\source\ProvisionData\ProvisionData.Common\LocalPackages" allowInsecureConnections="True" />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />

	</packageSources>

    <packageSourceMapping>

        <packageSource key="LocalPackages">
            <package pattern="ProvisionData.Result*" />
        </packageSource>

		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
		
    </packageSourceMapping>

</configuration>
