<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace />
		<TargetFramework>netstandard2.0</TargetFramework>

		<!-- NuGet package metadata -->
		<PackageId>ProvisionData.ResultPattern.CodeFixes</PackageId>
		<Title>Provision Data Result Pattern Library</Title>
		<Description>Classes and utilities for implementing the Result pattern in Provision Data projects.</Description>
		<PackageTags></PackageTags>
		<PackageReadmeFile>./README.md</PackageReadmeFile>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<IsPackable>false</IsPackable>
		<IsAotCompatible>false</IsAotCompatible>
		<IsTrimmable>false</IsTrimmable>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>

		<!-- Analyzer/Source Generator settings -->
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<Analyzer>true</Analyzer>
		<IsRoslynComponent>true</IsRoslynComponent>
		<DevelopmentDependency>true</DevelopmentDependency>

		<!-- NerdBank.GitVersioning -->
		<NBGV_ThisAssemblyNamespace>ProvisionData.ResultPattern.CodeFixes.Versioning</NBGV_ThisAssemblyNamespace>
	</PropertyGroup>

	<ItemGroup>
		<None Include="./README.md" Pack="true" PackagePath="/" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\ProvisionData.ResultPattern.Shared\ProvisionData.ResultPattern.Shared.csproj" />
	</ItemGroup>

</Project>
