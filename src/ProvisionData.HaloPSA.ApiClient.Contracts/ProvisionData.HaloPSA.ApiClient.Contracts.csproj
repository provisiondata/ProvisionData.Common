<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
		<RootNamespace />
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>

        <!-- NuGet package metadata -->
        <PackageId>ProvisionData.HaloPSA.ApiClient.Contracts</PackageId>
        <Description>HaloPSA API Client for .NET providing typed models and client helpers.</Description>
        <PackageTags>HaloPSA;API;Client</PackageTags>
        <PackageReadmeFile>./README.md</PackageReadmeFile>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <IsPackable>true</IsPackable>
        <ErrorReport>send</ErrorReport>
        <IncludeSymbols>true</IncludeSymbols>
        <IncludeSource>true</IncludeSource>

        <!-- Project Specific -->
        <IsAotCompatible>true</IsAotCompatible>
        <IsTrimmable>false</IsTrimmable>

        <!-- NerdBank.GitVersioning -->
        <NBGV_ThisAssemblyNamespace>ProvisionData.Dapper.Versioning</NBGV_ThisAssemblyNamespace>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\ProvisionData.HaloPSA.ApiClient\README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

	<Target Name="CopyPackage" AfterTargets="Pack">
		<Message Text="Copying $(OutputPath)$(PackageId).$(PackageVersion).nupkg to $(ProjectDir)..\..\LocalPackages" Importance="High" />
		<Copy SourceFiles="$(OutputPath)$(PackageId).$(PackageVersion).nupkg" DestinationFolder="$(ProjectDir)..\..\LocalPackages" />
	</Target>

	<ItemGroup>
        <Using Include="System.Text.Json.Serialization" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration" />
    </ItemGroup>

</Project>
